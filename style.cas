* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

:root {
color-scheme: dark;
--background: #08090d;
--panel: #11131b;
--border: #252838;
--purple: #8b5cf6;
--blue: #6366f1;
--text: #f5f5fa;
--muted: #9295a8;
}

body {
min-height: 100vh;
background:
radial-gradient(ellipse at top, #20143d 0%, transparent 48%),
var(--background);
color: var(--text);
font-family: Arial, Helvetica, sans-serif;
display: flex;
justify-content: center;
padding: 16px;
}

.app {
width: 100%;
max-width: 760px;
min-height: calc(100vh - 32px);
display: flex;
flex-direction: column;
background: rgba(12, 13, 20, 0.94);
border: 1px solid var(--border);
border-radius: 22px;
overflow: hidden;
box-shadow: 0 20px 80px rgba(0, 0, 0, 0.35);
}

.header {
display: flex;
align-items: center;
gap: 13px;
padding: 20px;
border-bottom: 1px solid var(--border);
background: rgba(20, 21, 33, 0.8);
}

.logo {
width: 48px;
height: 48px;
display: grid;
place-items: center;
font-size: 25px;
border-radius: 16px;
background: linear-gradient(135deg, #8b5cf6, #4f46e5);
box-shadow: 0 5px 24px rgba(139, 92, 246, 0.25);
}

.header h1 {
font-size: 21px;
letter-spacing: -0.5px;
}

.header p {
color: var(--muted);
font-size: 12px;
margin-top: 5px;
}

.online-dot {
display: inline-block;
width: 7px;
height: 7px;
background: #34d399;
border-radius: 50%;
margin-right: 5px;
box-shadow: 0 0 10px #34d399;
}

#chat {
flex: 1;
padding: 22px 16px;
overflow-y: auto;
display: flex;
flex-direction: column;
gap: 20px;
min-height: 280px;
}

.message {
display: flex;
flex-direction: column;
max-width: 88%;
gap: 7px;
animation: appear 0.25s ease;
}

.message.ai {
align-self: flex-start;
}

.message.user {
align-self: flex-end;
}

.bubble {
padding: 13px 16px;
border-radius: 17px;
font-size: 15px;
line-height: 1.65;
overflow-wrap: anywhere;
white-space: pre-wrap;
}

.ai .bubble {
background: #191b28;
border: 1px solid #292c40;
border-top-left-radius: 5px;
}

.user .bubble {
background: linear-gradient(135deg, #7650e8, #5544c9);
border-top-right-radius: 5px;
color: white;
}

.time {
color: #777b90;
font-size: 10px;
padding: 0 5px;
}

.user .time {
text-align: right;
}

.suggestions {
display: flex;
gap: 9px;
padding: 0 15px 15px;
flex-wrap: wrap;
}

.suggestions button {
background: #171925;
color: #c6b8ff;
border: 1px solid #34304d;
padding: 10px 13px;
border-radius: 20px;
font-size: 12px;
cursor: pointer;
}

.suggestions button:hover {
background: #25203b;
}

#chat-form {
display: flex;
align-items: center;
gap: 10px;
padding: 13px;
margin: 0 13px 13px;
border-radius: 17px;
background: #171923;
border: 1px solid #303244;
transition: border-color 0.2s;
}

#chat-form:focus-within {
border-color: var(--purple);
box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
}

#user-input {
flex: 1;
min-width: 0;
border: none;
outline: none;
background: transparent;
color: white;
font-size: 15px;
padding: 7px 4px;
}

#user-input::placeholder {
color: #777b90;
}

#send-btn {
width: 43px;
height: 43px;
flex-shrink: 0;
border: none;
border-radius: 13px;
background: linear-gradient(135deg, #8b5cf6, #5544d5);
color: white;
font-size: 22px;
cursor: pointer;
transition: transform 0.2s, opacity 0.2s;
}

#send-btn:active {
transform: scale(0.92);
}

#send-btn:disabled {
opacity: 0.5;
cursor: wait;
}

footer {
text-align: center;
color: #696d80;
font-size: 11px;
padding: 0 12px 15px;
}

.typing {
color: #b8a5ff;
font-size: 13px;
padding: 5px;
}

@keyframes appear {
from {
opacity: 0;
transform: translateY(7px);
}
to {
opacity: 1;
transform: translateY(0);
}
}

@media (max-width: 480px) {
body {
padding: 0;
}

.app {
min-height: 100vh;
border-radius: 0;
border: none;
}

.header {
padding: 16px;
}

#chat {
padding: 18px 12px;
}

.bubble {
font-size: 14px;
}
  }
