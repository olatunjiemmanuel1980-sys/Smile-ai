/* =========================================
SMILE AI — FUTURISTIC DARK THEME
Complete responsive stylesheet
========================================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

:root {
color-scheme: dark;

--bg: #03040a;
--panel: rgba(10, 14, 28, 0.94);
--panel-light: rgba(18, 25, 45, 0.95);

--cyan: #00e5ff;
--blue: #3977ff;
--purple: #a855f7;

--text: #f0f5ff;
--muted: #8997b5;

--border: rgba(0, 229, 255, 0.25);
--glow: rgba(0, 229, 255, 0.15);

}

/* PAGE BACKGROUND */

html {
min-height: 100%;
background: var(--bg);
scroll-behavior: smooth;
}

body {
min-height: 100vh;
min-height: 100dvh;
overflow: hidden;

font-family: Arial, Helvetica, sans-serif;
color: var(--text);

background:
    radial-gradient(
        ellipse at 15% 15%,
        rgba(0, 119, 255, 0.18),
        transparent 40%
    ),
    radial-gradient(
        ellipse at 85% 30%,
        rgba(168, 85, 247, 0.15),
        transparent 38%
    ),
    radial-gradient(
        ellipse at 50% 100%,
        rgba(0, 229, 255, 0.09),
        transparent 45%
    ),
    #03040a;

position: relative;

}

/* FUTURISTIC GRID BACKGROUND */

body::before {
content: "";
position: fixed;
inset: 0;
z-index: 0;
pointer-events: none;

background-image:
    linear-gradient(
        rgba(0, 229, 255, 0.045) 1px,
        transparent 1px
    ),
    linear-gradient(
        90deg,
        rgba(0, 229, 255, 0.045) 1px,
        transparent 1px
    );

background-size: 35px 35px;

mask-image: linear-gradient(
    to bottom,
    black,
    transparent 95%
);

}

/* AMBIENT LIGHT EFFECT */

body::after {
content: "";
position: fixed;

width: 260px;
height: 260px;

top: -130px;
right: -100px;

border-radius: 50%;

background: rgba(0, 229, 255, 0.12);
filter: blur(80px);

pointer-events: none;
z-index: 0;

}

/* MAIN APPLICATION */

.app {
position: relative;
z-index: 1;

width: 100%;
max-width: 900px;

height: 100vh;
height: 100dvh;

margin: 0 auto;

display: flex;
flex-direction: column;

overflow: hidden;

background: rgba(3, 4, 10, 0.45);
border-left: 1px solid rgba(0, 229, 255, 0.08);
border-right: 1px solid rgba(0, 229, 255, 0.08);

}

/* HEADER */

header {
flex-shrink: 0;

padding: 18px 20px;

background: rgba(8, 13, 27, 0.88);

border-bottom: 1px solid var(--border);

box-shadow:
    0 5px 30px rgba(0, 229, 255, 0.05);

backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);

}

header h1 {
font-size: 25px;
font-weight: 800;
letter-spacing: 0.5px;

color: var(--cyan);

text-shadow:
    0 0 10px rgba(0, 229, 255, 0.55),
    0 0 25px rgba(0, 229, 255, 0.2);

}

header p {
margin-top: 6px;

font-size: 13px;
color: var(--muted);

}

header p:first-of-type {
color: #63ffb0;
}

/* STATUS TEXT */

#status {
color: var(--muted);
font-size: 12px;
margin-top: 8px;
}

/* CHAT AREA */

#chat {
flex: 1;
min-height: 0;

overflow-y: auto;
overscroll-behavior: contain;

padding: 22px 16px;

display: flex;
flex-direction: column;
gap: 12px;

scroll-behavior: smooth;

}

/* CHAT SCROLLBAR */

#chat::-webkit-scrollbar {
width: 5px;
}

#chat::-webkit-scrollbar-track {
background: transparent;
}

#chat::-webkit-scrollbar-thumb {
background: rgba(0, 229, 255, 0.35);
border-radius: 20px;
}

/* MESSAGE BUBBLES */

.message {
position: relative;

max-width: 86%;
width: fit-content;

padding: 13px 15px;

border-radius: 17px;

font-size: 15px;
line-height: 1.65;

overflow-wrap: anywhere;
white-space: pre-wrap;

animation: messageAppear 0.3s ease-out;

}

@keyframes messageAppear {
from {
opacity: 0;
transform: translateY(8px);
}

to {
    opacity: 1;
    transform: translateY(0);
}

}

/* SMILE AI MESSAGE */

.bot {
align-self: flex-start;

color: #e5efff;

background:
    linear-gradient(
        135deg,
        rgba(15, 28, 50, 0.97),
        rgba(14, 17, 35, 0.97)
    );

border: 1px solid rgba(0, 229, 255, 0.25);

border-bottom-left-radius: 5px;

box-shadow:
    0 4px 18px rgba(0, 229, 255, 0.055);

}

/* USER MESSAGE */

.user {
align-self: flex-end;

color: white;

background:
    linear-gradient(
        135deg,
        #087eaa,
        #3946a8
    );

border: 1px solid rgba(0, 229, 255, 0.5);

border-bottom-right-radius: 5px;

box-shadow:
    0 4px 20px rgba(0, 145, 255, 0.12);

}

/* MESSAGE TIME */

.time {
display: block;

margin-top: 7px;

font-size: 10px;
color: #93a7c8;

text-align: right;

}

/* TYPING INDICATOR */

.typing {
align-self: flex-start;

padding: 13px 17px;

border-radius: 15px;

background: var(--panel-light);
border: 1px solid var(--border);

color: var(--cyan);

}

/* SUGGESTION BUTTONS */

.suggestions {
flex-shrink: 0;

display: flex;
gap: 9px;

padding: 10px 13px;

overflow-x: auto;

background: rgba(3, 4, 10, 0.45);

}

.suggestions::-webkit-scrollbar {
height: 3px;
}

.suggestions::-webkit-scrollbar-thumb {
background: var(--border);
}

.suggestions button {
flex-shrink: 0;

padding: 10px 14px;

border: 1px solid rgba(0, 229, 255, 0.35);
border-radius: 22px;

color: var(--cyan);

background: rgba(10, 24, 42, 0.9);

font-size: 12px;
font-weight: 600;

transition:
    background 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;

}

.suggestions button:hover {
background: rgba(0, 229, 255, 0.13);

box-shadow:
    0 0 15px rgba(0, 229, 255, 0.15);

}

.suggestions button:active {
transform: scale(0.96);
}

/* MESSAGE INPUT AREA */

form {
flex-shrink: 0;

display: flex;
align-items: center;
gap: 10px;

padding: 13px;

background: rgba(8, 13, 27, 0.95);

border-top: 1px solid var(--border);

box-shadow:
    0 -5px 25px rgba(0, 229, 255, 0.04);

padding-bottom: calc(13px + env(safe-area-inset-bottom));

}

/* TEXT INPUT */

#messageInput {
flex: 1;
min-width: 0;

padding: 14px 17px;

border: 1px solid rgba(0, 229, 255, 0.23);
border-radius: 25px;

outline: none;

color: var(--text);
background: rgba(17, 24, 42, 0.95);

font-family: inherit;
font-size: 14px;

transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;

}

#messageInput::placeholder {
color: #71809e;
}

#messageInput:focus {
border-color: var(--cyan);

box-shadow:
    0 0 0 3px rgba(0, 229, 255, 0.08),
    0 0 18px rgba(0, 229, 255, 0.08);

}

/* SEND BUTTON */

#sendButton {
flex-shrink: 0;

padding: 13px 18px;

border: none;
border-radius: 25px;

color: #03040a;

background:
    linear-gradient(
        135deg,
        #00e5ff,
        #4c9dff
    );

font-size: 13px;
font-weight: 800;

box-shadow:
    0 0 18px rgba(0, 229, 255, 0.2);

transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;

}

#sendButton:hover {
box-shadow:
0 0 25px rgba(0, 229, 255, 0.4);
}

#sendButton:active {
transform: scale(0.95);
}

#sendButton:disabled {
opacity: 0.5;
cursor: not-allowed;
}

/* GENERAL BUTTON ACCESSIBILITY */

button {
cursor: pointer;
-webkit-tap-highlight-color: transparent;
}

button:focus-visible {
outline: 2px solid var(--cyan);
outline-offset: 3px;
}

/* LINKS INSIDE CHAT */

.message a {
color: var(--cyan);
overflow-wrap: anywhere;
}

/* CODE INSIDE CHAT */

.message pre {
max-width: 100%;
overflow-x: auto;

padding: 12px;

margin-top: 10px;

border-radius: 9px;

background: #050914;
border: 1px solid rgba(0, 229, 255, 0.2);

}

.message code {
font-family: monospace;
}

/* SELECTION COLOR */

::selection {
color: white;
background: rgba(0, 180, 255, 0.45);
}

/* PHONE RESPONSIVENESS */

@media (max-width: 600px) {
.app {
width: 100%;
border: none;
}

header {
    padding: 16px;
}

header h1 {
    font-size: 23px;
}

#chat {
    padding: 17px 12px;
    gap: 11px;
}

.message {
    max-width: 91%;
    font-size: 14px;
    padding: 12px 13px;
}

.suggestions {
    padding: 8px 10px;
    gap: 7px;
}

.suggestions button {
    padding: 9px 12px;
    font-size: 11px;
}

form {
    gap: 7px;
    padding: 10px;
    padding-bottom: calc(10px + env(safe-area-inset-bottom));
}

#messageInput {
    padding: 13px 14px;
    font-size: 14px;
}

#sendButton {
    padding: 13px 15px;
}

}

/* SMALL PHONES */

@media (max-width: 360px) {
header h1 {
font-size: 21px;
}

.message {
    max-width: 94%;
    font-size: 13px;
}

#sendButton {
    padding: 12px;
}

.suggestions button {
    padding: 8px 10px;
}

}

/* REDUCE ANIMATIONS WHEN REQUESTED */

@media (prefers-reduced-motion: reduce) {
*,
*::before,
*::after {
animation-duration: 0.01ms !important;
animation-iteration-count: 1 !important;
scroll-behavior: auto !important;
transition-duration: 0.01ms !important;
}
}
