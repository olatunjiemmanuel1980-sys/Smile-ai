* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

:root {
color-scheme: dark;
--bg: #03040a;
--panel: rgba(10, 14, 28, 0.94);
--border: rgba(0, 229, 255, 0.22);
--cyan: #00e5ff;
--blue: #3977ff;
--purple: #a855f7;
--text: #f0f5ff;
--muted: #8997b5;
}

html {
min-height: 100%;
background: var(--bg);
}

body {
min-height: 100vh;
padding: 16px;
display: flex;
justify-content: center;
color: var(--text);
font-family: Inter, "Segoe UI", Arial, sans-serif;
background:
radial-gradient(ellipse at 10% 15%, rgba(0, 229, 255, 0.12), transparent 38%),
radial-gradient(ellipse at 90% 80%, rgba(168, 85, 247, 0.13), transparent 40%),
radial-gradient(ellipse at 50% 50%, #0b1020 0%, #03040a 75%);
background-attachment: fixed;
overflow-x: hidden;
position: relative;
}

/* Futuristic background grid */
body::before {
content: "";
position: fixed;
inset: 0;
pointer-events: none;
z-index: 0;
background-image:
linear-gradient(rgba(0, 229, 255, 0.035) 1px, transparent 1px),
linear-gradient(90deg, rgba(0, 229, 255, 0.035) 1px, transparent 1px);
background-size: 38px 38px;
mask-image: linear-gradient(to bottom, black, transparent 90%);
animation: gridPulse 8s ease-in-out infinite alternate;
}

body::after {
content: "";
position: fixed;
width: 320px;
height: 320px;
top: -130px;
left: 50%;
transform: translateX(-50%);
border-radius: 50%;
border: 1px solid rgba(0, 229, 255, 0.13);
box-shadow:
0 0 50px rgba(0, 229, 255, 0.07),
inset 0 0 50px rgba(0, 229, 255, 0.05);
pointer-events: none;
z-index: 0;
}

.app {
width: 100%;
max-width: 780px;
min-height: calc(100vh - 32px);
display: flex;
flex-direction: column;
position: relative;
z-index: 1;
overflow: hidden;
background: rgba(5, 8, 18, 0.91);
border: 1px solid rgba(0, 229, 255, 0.24);
border-radius: 22px;
box-shadow:
0 0 25px rgba(0, 229, 255, 0.07),
0 0 80px rgba(57, 119, 255, 0.06),
inset 0 0 35px rgba(0, 229, 255, 0.025);
backdrop-filter: blur(18px);
}

/* Header */
.header {
display: flex;
align-items: center;
gap: 14px;
padding: 20px;
background: linear-gradient(
110deg,
rgba(0, 229, 255, 0.07),
rgba(168, 85, 247, 0.08),
transparent
);
border-bottom: 1px solid var(--border);
position: relative;
}

.header::after {
content: "";
position: absolute;
height: 1px;
bottom: -1px;
left: 15%;
right: 15%;
background: linear-gradient(
90deg,
transparent,
var(--cyan),
var(--purple),
transparent
);
opacity: 0.7;
}

.logo {
width: 50px;
height: 50px;
flex-shrink: 0;
display: grid;
place-items: center;
font-size: 26px;
border-radius: 16px;
background: linear-gradient(135deg, #071c31, #29144a);
border: 1px solid rgba(0, 229, 255, 0.6);
box-shadow:
0 0 14px rgba(0, 229, 255, 0.22),
inset 0 0 12px rgba(168, 85, 247, 0.16);
animation: logoGlow 3s ease-in-out infinite alternate;
}

.header h1 {
font-size: 22px;
font-weight: 750;
letter-spacing: 0.4px;
background: linear-gradient(90deg, #ffffff, #79efff, #bd9aff);
background-clip: text;
-webkit-background-clip: text;
color: transparent;
}

.header p {
margin-top: 6px;
font-size: 12px;
color: var(--muted);
}

.online-dot {
display: inline-block;
width: 7px;
height: 7px;
margin-right: 6px;
border-radius: 50%;
background: #00ffa3;
box-shadow: 0 0 10px #00ffa3;
animation: onlinePulse 1.8s infinite;
}

/* Chat area */
#chat {
flex: 1;
min-height: 280px;
padding: 24px 18px;
display: flex;
flex-direction: column;
gap: 22px;
overflow-y: auto;
scrollbar-width: thin;
scrollbar-color: #263c60 transparent;
}

.message {
display: flex;
flex-direction: column;
gap: 7px;
max-width: 88%;
animation: messageIn 0.3s ease-out;
}

.message.ai {
align-self: flex-start;
}

.message.user {
align-self: flex-end;
}

.bubble {
padding: 14px 16px;
border-radius: 17px;
font-size: 15px;
line-height: 1.7;
white-space: pre-wrap;
overflow-wrap: anywhere;
}

.ai .bubble {
color: #e1ebff;
background: linear-gradient(
135deg,
rgba(15, 25, 47, 0.98),
rgba(16, 13, 35, 0.98)
);
border: 1px solid rgba(0, 229, 255, 0.19);
border-top-left-radius: 4px;
box-shadow: -3px 0 14px rgba(0, 229, 255, 0.035);
}

.user .bubble {
color: #ffffff;
background: linear-gradient(120deg, #1768c9, #5941bc);
border: 1px solid rgba(135, 185, 255, 0.45);
border-top-right-radius: 4px;
box-shadow: 0 0 18px rgba(57, 119, 255, 0.17);
}

.time {
padding: 0 5px;
font-size: 10px;
color: #73829f;
}

.user .time {
text-align: right;
}

/* Quick suggestion buttons */
.suggestions {
display: flex;
flex-wrap: wrap;
gap: 9px;
padding: 0 16px 16px;
}

.suggestions button {
padding: 10px 13px;
border-radius: 20px;
background: rgba(12, 23, 43, 0.9);
color: #8cefff;
border: 1px solid rgba(0, 229, 255, 0.25);
font-size: 12px;
cursor: pointer;
transition: 0.25s ease;
}

.suggestions button:hover {
background: rgba(0, 229, 255, 0.1);
border-color: var(--cyan);
box-shadow: 0 0 15px rgba(0, 229, 255, 0.13);
transform: translateY(-2px);
}

/* Message input */
#chat-form {
display: flex;
align-items: center;
gap: 10px;
margin: 0 14px 14px;
padding: 10px 11px 10px 16px;
border-radius: 17px;
background: rgba(10, 16, 31, 0.97);
border: 1px solid rgba(0, 229, 255, 0.28);
box-shadow:
0 0 20px rgba(0, 229, 255, 0.035),
inset 0 0 15px rgba(0, 229, 255, 0.025);
transition: border-color 0.25s, box-shadow 0.25s;
}

#chat-form:focus-within {
border-color: var(--cyan);
box-shadow:
0 0 18px rgba(0, 229, 255, 0.13),
inset 0 0 15px rgba(0, 229, 255, 0.035);
}

#user-input {
flex: 1;
min-width: 0;
padding: 9px 2px;
color: white;
background: transparent;
border: none;
outline: none;
font-size: 15px;
}

#user-input::placeholder {
color: #71819f;
}

#send-btn {
width: 44px;
height: 44px;
flex-shrink: 0;
display: grid;
place-items: center;
border: 1px solid rgba(0, 229, 255, 0.6);
border-radius: 13px;
color: #ffffff;
background: linear-gradient(135deg, #087fbd, #6341c8);
font-size: 22px;
cursor: pointer;
box-shadow: 0 0 14px rgba(0, 229, 255, 0.13);
transition: transform 0.2s, box-shadow 0.2s;
}

#send-btn:hover {
transform: scale(1.05);
box-shadow: 0 0 22px rgba(0, 229, 255, 0.3);
}

#send-btn:active {
transform: scale(0.94);
}

#send-btn:disabled {
opacity: 0.5;
cursor: wait;
}

footer {
padding: 0 12px 16px;
text-align: center;
color: #6f7c9a;
font-size: 11px;
letter-spacing: 0.3px;
}

/* Animations */
@keyframes logoGlow {
from {
box-shadow: 0 0 10px rgba(0, 229, 255, 0.17);
}
to {
box-shadow:
0 0 20px rgba(0, 229, 255, 0.32),
0 0 30px rgba(168, 85, 247, 0.13);
}
}

@keyframes onlinePulse {
0%, 100% {
opacity: 1;
}
50% {
opacity: 0.45;
}
}

@keyframes gridPulse {
from {
opacity: 0.5;
}
to {
opacity: 1;
}
}

@keyframes messageIn {
from {
opacity: 0;
transform: translateY(8px);
}
to {
opacity: 1;
transform: translateY(0);
}
}

/* Phone layout */
@media (max-width: 480px) {
body {
padding: 0;
}

.app {
min-height: 100vh;
border-radius: 0;
border-left: 0;
border-right: 0;
}

.header {
padding: 17px;
}

#chat {
padding: 20px 12px;
}

.bubble {
font-size: 14px;
padding: 12px 14px;
}

.suggestions {
padding-left: 12px;
padding-right: 12px;
}
}

/* Respect devices that prefer reduced motion */
@media (prefers-reduced-motion: reduce) {
*,
*::before,
*::after {
animation-duration: 0.01ms !important;
animation-iteration-count: 1 !important;
scroll-behavior: auto !important;
transition-duration: 0.01ms !important;
}
}
